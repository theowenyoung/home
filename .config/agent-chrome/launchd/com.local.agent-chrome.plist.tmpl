<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.agent-chrome</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.config/agent-chrome/bin/agent-chrome</string>
    <string>foreground</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/agent-chrome.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/agent-chrome.log</string>
</dict>
</plist>
